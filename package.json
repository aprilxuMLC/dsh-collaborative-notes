{
  "name": "dsh-collab-notes",
  "version": "0.1.0",
  "description": "Shared attention workspace for DeepSeek Harness: transient collaborative Notes with provenance, source re-entry, and controlled reactivation",
  "repository": {
    "type": "git",
    "url": "https://github.com/aprilxuMLC/dsh-collaborative-notes.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test:client": "vitest run",
    "verify:public": "npm run bundle && node scripts/check-bundle.mjs && npm run test:client && node test/skill-materialization-validation.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^14.3.1",
    "happy-dom": "^20.11.2",
    "react": "^18.3.1",
    "tsdown": "^0.4.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "skill",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
